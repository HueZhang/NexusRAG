# NexusRAG 环境变量模板
# 用法：复制为 .env 后填入真实值；.env 不进仓库（见 .gitignore）。
# 本文件只放占位符，绝不放真实密钥。

# ---- LLM 提供方（适配层，可切换多家 / 本地）----
# 通用 OpenAI 兼容接口（DeepSeek / 通义 / 智谱 / 本地 vLLM 等大多兼容）
LLM_PROVIDER=deepseek            # deepseek | qwen | zhipu | openai | ollama
LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# ---- 本地模型（可选，LLM_PROVIDER=ollama 时用）----
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# ---- Embedding ----
EMBED_PROVIDER=local             # local(BGE) | openai-compatible
EMBED_MODEL=BAAI/bge-m3
EMBED_API_KEY=
EMBED_BASE_URL=

# ---- 向量库 ----
VECTOR_DB=chroma                 # chroma | pgvector | milvus
VECTOR_DB_URL=./data/processed/chroma
PGVECTOR_DSN=

# ---- 应用 ----
LOG_LEVEL=INFO
